{
  "datasets": [
    {
      "name": "funnel",
      "displayName": "Batch: triage funnel (latest day)",
      "queryLines": [
        "SELECT (SELECT COUNT(*) FROM arr_triage_history_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l)) AS total_signals, ",
        "(SELECT COUNT(*) FROM arr_triage_history_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) AND arr_flag = 1) AS flagged_abnormal, ",
        "(SELECT COUNT(*) FROM dailyOrweekly_arr_afib_inference_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) AND afib_predictions_1 > 0.5) AS afib_positive"
      ]
    },
    {
      "name": "arrivals",
      "displayName": "Batch: ECGs landed per hour (latest day)",
      "queryLines": [
        "SELECT hour(acquisition_datetime_utc) AS hour_utc, CASE rhythm_label WHEN 0 THEN 'NSR' WHEN 1 THEN 'AFib' WHEN 2 THEN 'Other' END AS rhythm, COUNT(*) AS n ",
        "FROM arr_triage_history_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) ",
        "GROUP BY hour(acquisition_datetime_utc), rhythm_label ORDER BY hour_utc, rhythm_label"
      ]
    },
    {
      "name": "triage_accuracy",
      "displayName": "Batch: triage by rhythm (latest day)",
      "queryLines": [
        "SELECT CASE rhythm_label WHEN 0 THEN 'NSR' WHEN 1 THEN 'AFib' WHEN 2 THEN 'Other' END AS rhythm, ",
        "CASE WHEN arr_flag = 1 THEN 'flagged (->afib)' ELSE 'not flagged' END AS triage, ",
        "COUNT(*) AS n FROM arr_triage_history_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) GROUP BY rhythm_label, arr_flag ORDER BY rhythm_label"
      ]
    },
    {
      "name": "prob_hist",
      "displayName": "Batch: AFib probability (latest day)",
      "queryLines": [
        "SELECT ROUND(afib_predictions_1, 1) AS prob_bin, COUNT(*) AS n FROM dailyOrweekly_arr_afib_inference_12l ",
        "WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) GROUP BY ROUND(afib_predictions_1, 1) ORDER BY prob_bin"
      ]
    },
    {
      "name": "trend",
      "displayName": "Batch: daily trend (every day)",
      "queryLines": [
        "SELECT batch_date AS date, ",
        "COUNT(*) AS afib_classified, ",
        "SUM(CASE WHEN afib_predictions_1 > 0.5 THEN 1 ELSE 0 END) AS afib_positive FROM dailyOrweekly_arr_afib_inference_12l ",
        "GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "afib_by_age",
      "displayName": "Batch: AFib-positive by age band (latest day)",
      "queryLines": [
        "SELECT t.age_band, COUNT(*) AS screened, ",
        "SUM(CASE WHEN i.afib_predictions_1 > 0.5 THEN 1 ELSE 0 END) AS afib_positive, ",
        "ROUND(SUM(CASE WHEN i.afib_predictions_1 > 0.5 THEN 1 ELSE 0 END) / COUNT(*), 3) AS afib_positive_share ",
        "FROM (SELECT pseudo_patient_id, CASE WHEN age_years < 50 THEN '40-49' WHEN age_years < 60 THEN '50-59' WHEN age_years < 70 THEN '60-69' WHEN age_years < 80 THEN '70-79' ELSE '80-90' END AS age_band FROM arr_triage_history_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l)) t ",
        "LEFT JOIN (SELECT pseudo_patient_id, afib_predictions_1 FROM dailyOrweekly_arr_afib_inference_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l)) i ",
        "USING (pseudo_patient_id) GROUP BY t.age_band ORDER BY t.age_band"
      ]
    },
    {
      "name": "worklist",
      "displayName": "Batch: flagged-patient worklist (latest day)",
      "queryLines": [
        "SELECT batch_date AS batch_date, mrn, age_years AS age, sex, bmi, heart_rate_bpm AS hr_bpm, ",
        "CONCAT(bp_systolic_mmhg, '/', bp_diastolic_mmhg) AS bp_mmhg, ",
        "CASE rhythm_label WHEN 0 THEN 'NSR' WHEN 1 THEN 'AFib' WHEN 2 THEN 'Other' END AS true_rhythm, ROUND(afib_predictions_1, 3) AS p_afib, ",
        "CASE WHEN afib_predictions_1 > 0.5 THEN 'AFib' ELSE 'not AFib' END AS afib_call, ",
        "date_format(acquisition_datetime_utc, 'HH:mm') AS acquired_utc ",
        "FROM dailyOrweekly_arr_afib_inference_12l WHERE batch_date = (SELECT max(batch_date) FROM arr_triage_history_12l) ORDER BY afib_predictions_1 DESC LIMIT 25"
      ]
    },
    {
      "name": "live_requests",
      "displayName": "Live: endpoint requests (AI Gateway inference tables)",
      "queryLines": [
        "SELECT 'bio_ecg12_arr (triage)' AS endpoint, databricks_request_id, request_time, date_trunc('HOUR', request_time) AS request_hour, status_code, execution_duration_ms, ROUND(length(request) / 1024.0, 0) AS request_kb, CASE WHEN request IS NULL OR coalesce(size(logging_error_codes), 0) > 0 THEN 1 ELSE 0 END AS not_logged FROM bio_ecg12_arr_payload ",
        "UNION ALL ",
        "SELECT 'bio_ecg12_afib (classify)' AS endpoint, databricks_request_id, request_time, date_trunc('HOUR', request_time) AS request_hour, status_code, execution_duration_ms, ROUND(length(request) / 1024.0, 0) AS request_kb, CASE WHEN request IS NULL OR coalesce(size(logging_error_codes), 0) > 0 THEN 1 ELSE 0 END AS not_logged FROM bio_ecg12_afib_payload ",
        "ORDER BY request_time DESC"
      ]
    },
    {
      "name": "live_predictions",
      "displayName": "Live: returned probabilities",
      "queryLines": [
        "SELECT 'bio_ecg12_arr (triage)' AS endpoint, request_time, p.arr_prob AS score, ROUND(p.arr_prob, 1) AS score_bin ",
        "FROM (SELECT request_time, explode(from_json(response, 'predictions ARRAY<STRUCT<arr_prob: DOUBLE, arr_flag: DOUBLE>>').predictions) AS p ",
        "FROM bio_ecg12_arr_payload WHERE status_code = 200 AND response IS NOT NULL) ",
        "UNION ALL ",
        "SELECT 'bio_ecg12_afib (classify)' AS endpoint, request_time, p[1] AS score, ROUND(p[1], 1) AS score_bin ",
        "FROM (SELECT request_time, explode(from_json(response, 'predictions ARRAY<ARRAY<DOUBLE>>').predictions) AS p ",
        "FROM bio_ecg12_afib_payload WHERE status_code = 200 AND response IS NOT NULL)"
      ]
    }
  ],
